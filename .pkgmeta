package-as: PriestShieldTracker
move-folders:
  PriestShieldTracker/Compatibility/SoulShield: SoulShield
enable-nolib-creation: no
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
ignore:
  - docs
  - tests
  - scripts
  - dist
  - logo-source
  - requirements-dev.txt
  - README.md
